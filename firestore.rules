rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    // --- User Profile Validation ---
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20 &&
        (!('email' in data) || data.email is string) &&
        (!('city' in data) || data.city is string) &&
        (!('defaultAddress' in data) || data.defaultAddress is string) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- Boutique Order Validation ---
    function isValidBoutiqueOrder(data, userId) {
      return data.userId == userId &&
        data.orderId is string && data.orderId.size() > 0 &&
        data.suitTitle is string && data.suitTitle.size() > 0 &&
        data.totalAmount is int && data.totalAmount >= 0 &&
        data.paymentMethod is string &&
        data.status is string &&
        (!('isPaid' in data) || data.isPaid is bool) &&
        (!('sampleCount' in data) || data.sampleCount is int) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- Measurement Profile Validation ---
    function isValidMeasurementProfile(data, userId) {
      return data.userId == userId &&
        data.profileId is string && data.profileId.size() > 0 &&
        data.label is string && data.label.size() > 0 && data.label.size() <= 60 &&
        data.bust is number && data.bust > 0 &&
        data.waist is number && data.waist > 0 &&
        data.hips is number && data.hips > 0 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- Tailor Consultation Validation ---
    function isValidTailorConsultation(data, userId) {
      return data.userId == userId &&
        data.consultationId is string && data.consultationId.size() > 0 &&
        data.name is string && data.name.size() > 0 &&
        data.phone is string && data.phone.size() >= 7 &&
        isValidTimestamp(data.createdAt);
    }

    // --- User Documents and Subcollections ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBoutiqueOrder(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidBoutiqueOrder(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /measurements/{profileId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMeasurementProfile(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidMeasurementProfile(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /consultations/{consultationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTailorConsultation(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidTailorConsultation(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
